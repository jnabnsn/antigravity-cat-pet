{
  "antigravity-hagemi-pet": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/emit.mjs",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/emit.mjs",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/emit.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/emit.mjs",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/emit.mjs",
        "timeout": 5
      }
    ]
  }
}
